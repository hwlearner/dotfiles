#!/usr/bin/env python3
"""Watch /srv/nas and extract newly written archives."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import zipfile
from datetime import datetime, timezone
from pathlib import Path


WATCH_DIR = Path(os.environ.get("NAS_WATCH_DIR", "/srv/nas"))
LOG_FILE = Path(os.environ.get("NAS_EXTRACT_LOG", "/var/log/auto-extract.log"))
BACKUP_PASSWORD = os.environ.get("NAS_BACKUP_PASSWORD", "TG@ioopro")
OWNER = os.environ.get("NAS_EXTRACT_OWNER", "han:han")
ARCHIVE_SUFFIXES = (".zip", ".rar", ".7z", ".tar.gz", ".tgz")


def log(message: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    with LOG_FILE.open("a", encoding="utf-8") as fh:
        fh.write(f"{stamp} {message}\n")


def run(args: list[str], *, timeout: int | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, capture_output=True, text=True, timeout=timeout)


def archive_stem(path: Path) -> str:
    name = path.name
    for suffix in (".tar.gz", ".tgz", ".zip", ".rar", ".7z"):
        if name.lower().endswith(suffix):
            return name[: -len(suffix)]
    return path.stem


def safe_member_path(target_dir: Path, member_name: str) -> Path:
    decoded = member_name
    try:
        decoded = member_name.encode("cp437").decode("gbk")
    except UnicodeError:
        pass
    target = (target_dir / decoded).resolve()
    root = target_dir.resolve()
    if target != root and root not in target.parents:
        raise ValueError(f"unsafe archive path: {member_name}")
    return target


def extract_zip(archive: Path, target_dir: Path) -> None:
    last_error: Exception | None = None
    for password in (None, BACKUP_PASSWORD.encode("utf-8")):
        try:
            with zipfile.ZipFile(archive) as zf:
                for info in zf.infolist():
                    target = safe_member_path(target_dir, info.filename)
                    if info.is_dir():
                        target.mkdir(parents=True, exist_ok=True)
                        continue
                    target.parent.mkdir(parents=True, exist_ok=True)
                    with zf.open(info, pwd=password) as src, target.open("wb") as dst:
                        shutil.copyfileobj(src, dst)
            return
        except Exception as exc:  # Try the fallback password after plain extraction.
            last_error = exc
            shutil.rmtree(target_dir, ignore_errors=True)
            target_dir.mkdir(parents=True, exist_ok=True)
    raise RuntimeError(f"zip extraction failed: {last_error}")


def extract_rar(archive: Path, target_dir: Path) -> None:
    unrar = shutil.which("unrar") or "/usr/local/bin/unrar"
    result = run([unrar, "x", "-o+", f"-p{BACKUP_PASSWORD}", str(archive), f"{target_dir}/"], timeout=3600)
    with LOG_FILE.open("a", encoding="utf-8", errors="replace") as fh:
        fh.write(result.stdout)
        fh.write(result.stderr)
    if result.returncode != 0:
        raise RuntimeError(f"unrar failed with exit {result.returncode}")


def extract_7z(archive: Path, target_dir: Path) -> None:
    seven_zip = shutil.which("7z") or "/usr/bin/7z"
    result = run([seven_zip, "x", "-y", f"-p{BACKUP_PASSWORD}", f"-o{target_dir}", str(archive)], timeout=3600)
    with LOG_FILE.open("a", encoding="utf-8", errors="replace") as fh:
        fh.write(result.stdout)
        fh.write(result.stderr)
    if result.returncode != 0:
        raise RuntimeError(f"7z failed with exit {result.returncode}")


def extract_tar(archive: Path, target_dir: Path) -> None:
    result = run(["tar", "-xzf", str(archive), "-C", str(target_dir)], timeout=3600)
    with LOG_FILE.open("a", encoding="utf-8", errors="replace") as fh:
        fh.write(result.stdout)
        fh.write(result.stderr)
    if result.returncode != 0:
        raise RuntimeError(f"tar failed with exit {result.returncode}")


def clean_result(target_dir: Path) -> None:
    subprocess.run(["python3", "/usr/local/bin/clean-names.py", str(target_dir)], check=False)
    shutil.rmtree(target_dir / "__MACOSX", ignore_errors=True)
    for item in target_dir.rglob(".DS_Store"):
        item.unlink(missing_ok=True)
    subprocess.run(["chown", "-R", OWNER, str(target_dir)], check=False)


def extract_archive(archive: Path) -> None:
    if not archive.is_file():
        return
    lower = archive.name.lower()
    if not lower.endswith(ARCHIVE_SUFFIXES):
        return

    target_dir = archive.with_name(archive_stem(archive))
    target_dir.mkdir(parents=True, exist_ok=True)
    log(f"Extracting: {archive.name}")
    try:
        if lower.endswith(".zip"):
            extract_zip(archive, target_dir)
        elif lower.endswith(".rar"):
            extract_rar(archive, target_dir)
        elif lower.endswith(".7z"):
            extract_7z(archive, target_dir)
        elif lower.endswith((".tar.gz", ".tgz")):
            extract_tar(archive, target_dir)
        clean_result(target_dir)
        archive.unlink()
        log(f"Done: {archive.name}")
    except Exception as exc:
        log(f"FAILED: {archive.name}: {exc}")


def watch() -> int:
    WATCH_DIR.mkdir(parents=True, exist_ok=True)
    inotifywait = shutil.which("inotifywait")
    if not inotifywait:
        log("FAILED: inotifywait not found")
        return 1

    cmd = [
        inotifywait,
        "-m",
        "-e",
        "close_write",
        "-e",
        "moved_to",
        "--format",
        "%w%f",
        str(WATCH_DIR),
    ]
    log(f"Watching: {WATCH_DIR}")
    with subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) as proc:
        assert proc.stdout is not None
        for line in proc.stdout:
            extract_archive(Path(line.rstrip("\n")))
        return proc.wait()


if __name__ == "__main__":
    sys.exit(watch())
