[Unit]
Description=NAS MCP Server for Hermes Agent
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=han
Environment=NAS_MCP_HOST=192.168.1.50
Environment=NAS_MCP_PORT=9121
ExecStart=/usr/bin/python3 /usr/local/bin/nas-mcp-server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
