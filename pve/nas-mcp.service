[Unit]
Description=NAS MCP Server for Hermes Agent
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=han
WorkingDirectory=/opt/nas-mcp
ExecStart=/usr/bin/python3 /opt/nas-mcp/nas-mcp-server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
