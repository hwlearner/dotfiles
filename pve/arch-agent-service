#!/bin/bash
# arch-agent-service - Manage systemd services
set -euo pipefail

action="${1:-}"
name="${2:-}"

usage() {
    echo "Usage: arch-agent-service <start|stop|restart|status|enable|disable> <unit>"
    exit 1
}

[ -n "$action" ] || usage
[ -n "$name" ] || usage

case "$action" in
    status)
        systemctl status "$name" --no-pager -n 20 2>&1
        ;;
    start|stop|restart)
        sudo systemctl "$action" "$name" 2>&1
        echo "{\"action\":\"$action\",\"unit\":\"$name\",\"result\":\"ok\"}"
        ;;
    enable|disable)
        sudo systemctl "$action" "$name" 2>&1
        echo "{\"action\":\"$action\",\"unit\":\"$name\",\"result\":\"ok\"}"
        ;;
    *)
        echo "Unknown action: $action"
        usage
        ;;
esac
