{
  // ========================================================================
  // macOS Sing-box 配置 — 上游: 家里 Clash (192.168.1.18:7890)
  // 家服不可达时自动回退到 DIRECT (直连)
  //
  // 管理面板: http://127.0.0.1:9090/ui  (需装 metacubexd 等 UI)
  // 终端代理: export http_proxy=http://127.0.0.1:7890
  // 系统代理: networksetup -setwebproxy Wi-Fi 127.0.0.1 7890
  //          networksetup -setsecurewebproxy Wi-Fi 127.0.0.1 7890
  // 健康检查脚本: cb-home-check (由 launchd 每 30s 自动执行)
  // ========================================================================

  "log": {
    "level": "info",
    "output": "/Users/han/.config/sing-box/sing-box.log",
    "timestamp": true
  },

  // ========================================================================
  // DNS — 优先用家里 Clash DNS，不可达时回退国内公共 DNS
  // ========================================================================
  "dns": {
    "servers": [
      {
        "tag": "home-clash-dns",
        "address": "192.168.1.18:5353",
        "detour": "home-clash"
      },
      {
        "tag": "ali-dns",
        "address": "223.5.5.5",
        "detour": "direct"
      },
      {
        "tag": "cloudflare",
        "address": "tls://1.1.1.1:853",
        "detour": "direct"
      }
    ],
    "strategy": "prefer_ipv4",
    "independent_cache": true,
    "rules": [
      {
        "outbound": "any",
        "server": "home-clash-dns"
      }
    ],
    "final": "home-clash-dns"
  },

  // ========================================================================
  // 入站: 本地代理端口
  // ========================================================================
  "inbounds": [
    {
      "type": "mixed",
      "tag": "local-proxy",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": false
    }
  ],

  // ========================================================================
  // 出站: 家里 Clash + 直连 + urltest 自动故障切换
  //
  // urltest 行为:
  //   - 有流量时每 30s 测一次 home-clash vs direct
  //   - 无流量超过 5 分钟 → 停止检测
  //   - 流量恢复 → 立即重测
  //   - 家服可达 → 优先选 home-clash (tolerance 500ms 内排第一)
  //   - 家服不可达 → 自动用 direct
  // ========================================================================
  "outbounds": [
    {
      "type": "socks",
      "tag": "home-clash",
      "server": "192.168.1.18",
      "server_port": 7890
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "urltest",
      "tag": "proxy",
      "outbounds": ["home-clash", "direct"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "30s",
      "tolerance": 500,
      "idle_timeout": "5m",
      "interrupt_exist_connections": false
    }
  ],

  // ========================================================================
  // 路由规则
  // ========================================================================
  "route": {
    "rules": [
      // DNS hijack
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      // 内网 & Tailscale 直连
      {
        "ip_cidr": [
          "192.168.0.0/16",
          "172.16.0.0/12",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "fd7a:115c:a1e0::/48"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "tail3fd170.ts.net",
          "local",
          "localhost"
        ],
        "outbound": "direct"
      },
      // 家里局域网服务直连
      {
        "ip_cidr": ["192.168.1.0/24"],
        "outbound": "direct"
      },
      // 国内常用服务直连（避免经过家服绕路）
      {
        "domain_suffix": [
          "deepseek.com",
          "minimax.com", "minimaxi.com",
          "hailuoai.com",
          "ustc.edu.cn",
          "debian.org",
          "huaweicloud.com", "huawei.com",
          "qq.com",
          "weixin.qq.com"
        ],
        "outbound": "direct"
      }
    ],
    "final": "proxy"
  },

  // ========================================================================
  // Clash API — 用于 cb-home-check 健康检查脚本切换 selector
  // ========================================================================
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "rule"
    }
  }
}
