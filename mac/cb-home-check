#!/bin/bash
# ==============================================================================
# cb-home-check — 检查家里 Clash 是否可达，自动切换 sing-box selector
#
# 工作原理:
#   1. 通过 Tailscale 子网路由检测 192.168.1.18:7890 是否可达
#   2. 如果可达 → 切 proxy selector 到 home-clash
#   3. 如果不可达 → 切 proxy selector 到 direct
#   4. 通过 sing-box Clash API (127.0.0.1:9090) 执行切换
#
# 安装为 launchd 定时任务（每 30 秒检查一次）
# ==============================================================================

set -euo pipefail

SING_BOX_API="http://127.0.0.1:9090"
PROXY_SELECTOR="proxy"
HOME_CLASH="home-clash"
FALLBACK="direct"
TIMEOUT=5
LOG_FILE="/Users/han/.config/sing-box/health-check.log"

# 日志函数
log() {
  local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
  echo "$msg" >> "$LOG_FILE"
  echo "$msg"
}

# 检查家里 Clash 是否可达
check_home_clash() {
  curl -sS --max-time "$TIMEOUT" \
    --socks5-hostname "192.168.1.18:7890" \
    -o /dev/null -w "%{http_code}" \
    "http://www.gstatic.com/generate_204" 2>/dev/null | grep -q "204"
}

# 通过 Clash API 获取当前选择的代理
get_current_proxy() {
  curl -sS --max-time 2 \
    "$SING_BOX_API/proxies/$PROXY_SELECTOR" 2>/dev/null | \
    python3 -c "import sys,json; print(json.load(sys.stdin).get('now',''))" 2>/dev/null || echo ""
}

# 通过 Clash API 切换代理
switch_proxy() {
  local target="$1"
  curl -sS --max-time 2 \
    -X PUT "$SING_BOX_API/proxies/$PROXY_SELECTOR" \
    -H "Content-Type: application/json" \
    -d "{\"name\":\"$target\"}" 2>/dev/null
}

# --- 主流程 ---
mkdir -p "$(dirname "$LOG_FILE")"

if check_home_clash; then
  current=$(get_current_proxy)
  if [ "$current" != "$HOME_CLASH" ]; then
    if switch_proxy "$HOME_CLASH"; then
      log "✅ 家服 Clash 已恢复，切换回 $HOME_CLASH"
    fi
  # else: 一切正常，静默（避免日志刷屏）
  fi
else
  current=$(get_current_proxy)
  if [ "$current" != "$FALLBACK" ]; then
    if switch_proxy "$FALLBACK"; then
      log "⚠️ 家服 Clash 不可达，已切至 $FALLBACK"
    fi
  fi
fi
