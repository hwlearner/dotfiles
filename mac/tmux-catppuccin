#!/usr/bin/env zsh
# ==============================================================================
# tmux-catppuccin — 根据 macOS 深浅色模式切换 tmux 状态栏颜色
# 用法: tmux-catppuccin apply          立即应用到当前 tmux
#       tmux-catppuccin watch         后台监听外观变化（launchd）
# ==============================================================================

CTP_DIR="/Users/han/.config/tmux"

# ---- Catppuccin 色卡 ----
declare -A MOCHA=(
  [text]="#cdd6f4" [blue]="#89b4fa" [mauve]="#cba6f7" [green]="#a6e3a1"
  [surface]="#313244" [overlay]="#6c7086" [subtext]="#a6adc8" [red]="#f38ba8"
  [peach]="#fab387" [yellow]="#f9e2af"
)

declare -A LATTE=(
  [text]="#4c4f69" [blue]="#1e66f5" [mauve]="#8839ef" [green]="#40a02b"
  [surface]="#e6e9ef" [overlay]="#9ca0b0" [subtext]="#6c6f85" [red]="#d20f39"
  [peach]="#fe640b" [yellow]="#df8e1d"
)

detect_theme() {
  if [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null) == "Dark" ]]; then
    echo "mocha"
  else
    echo "latte"
  fi
}

PI_SETTINGS="$HOME/.pi/agent/settings.json"

apply() {
  local theme=$(detect_theme)
  local -n colors
  if [[ "$theme" == "mocha" ]]; then
    colors=MOCHA
    pi_theme="catppuccin-mocha"
  else
    colors=LATTE
    pi_theme="catppuccin-latte"
  fi

  # ---- tmux 配色 ----
  tmux set -g status-style "bg=default,fg=${colors[text]}"
  tmux set -g window-status-style "bg=default,fg=${colors[overlay]}"
  tmux set -g window-status-current-style "bg=default,fg=${colors[blue]}"
  tmux set -g window-status-current-format "#[bg=default]● #W "
  tmux set -g window-status-format "#[bg=default]○ #W "
  tmux set -g pane-active-border-style "fg=${colors[blue]},bg=default"
  tmux set -g pane-border-style "fg=${colors[overlay]},bg=default"

  # ---- pi 主题同步 ----
  if [[ -f "$PI_SETTINGS" ]]; then
    local current=$(python3 -c "import json; print(json.load(open('$PI_SETTINGS')).get('theme',''))" 2>/dev/null)
    if [[ "$current" != "$pi_theme" ]]; then
      python3 -c "
import json
with open('$PI_SETTINGS') as f:
    s = json.load(f)
s['theme'] = '$pi_theme'
with open('$PI_SETTINGS', 'w') as f:
    json.dump(s, f, indent=2, ensure_ascii=False)
print('ok')
" 2>/dev/null
      echo "pi: theme → $pi_theme (下次启动生效)"
    fi
  fi

  echo "tmux: applied Catppuccin $theme"
}

case "${1:-apply}" in
  apply)
    apply
    ;;
  watch)
    # 监听 macOS 外观变化（需配合 launchd 使用）
    # 或用 polling 方式
    while true; do
      sleep 5
      apply 2>/dev/null
    done
    ;;
esac
