<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.han.mihomo</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/mihomo</string>
    <string>-d</string>
    <string>/Users/han/.config/mihomo</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/han</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/han/.config/mihomo/mihomo.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/han/.config/mihomo/mihomo.stderr.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/han</string>
</dict>
</plist>
