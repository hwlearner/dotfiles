# This is the configuration file for Ghostty.

font-family = Maple Mono NL NF CN
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = hidden
cursor-style = block
cursor-style-blink = false

# Prefer separate windows over native tabs so AeroSpace can tile Ghostty reliably.
window-save-state = never
keybind = cmd+t=new_window
keybind = cmd+n=new_window

# Oh My Pi: make Option+Backspace send the expected delete-word sequence.
keybind = alt+backspace=text:\x1b\x7f
background-opacity = 0.85
