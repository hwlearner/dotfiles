#!/bin/bash
# arch-agent-dev - Developer operations (git, project status)
set -euo pipefail

action="${1:-}"
arg="${2:-}"

usage() {
    echo "Usage: arch-agent-dev <ws-list|ws-status|git-log|git-pull> [workspace]"
    exit 1
}

[ -n "$action" ] || usage

WS_ROOT="/srv/workspaces"

case "$action" in
    ws-list)
        if [ -d "$WS_ROOT" ]; then
            ls -1 "$WS_ROOT"
        else
            echo "[]"
        fi
        ;;
    ws-status)
        [ -n "$arg" ] || { echo "Workspace name required"; exit 1; }
        ws="$WS_ROOT/$arg"
        [ -d "$ws" ] || { echo "Workspace '$arg' not found"; exit 1; }
        cd "$ws"
        echo "--- Branch ---"
        git branch --show-current 2>/dev/null || echo "not a git repo"
        echo "--- Status ---"
        git status --short 2>/dev/null || echo "not a git repo"
        ;;
    git-log)
        [ -n "$arg" ] || { echo "Workspace name required"; exit 1; }
        ws="$WS_ROOT/$arg"
        [ -d "$ws" ] || { echo "Workspace '$arg' not found"; exit 1; }
        cd "$ws"
        git log --oneline -10 2>/dev/null || echo "not a git repo"
        ;;
    git-pull)
        [ -n "$arg" ] || { echo "Workspace name required"; exit 1; }
        ws="$WS_ROOT/$arg"
        [ -d "$ws" ] || { echo "Workspace '$arg' not found"; exit 1; }
        cd "$ws"
        git pull 2>&1
        ;;
    *)
        echo "Unknown action: $action"
        usage
        ;;
esac
