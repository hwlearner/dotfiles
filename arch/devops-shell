#!/bin/bash
# devops-shell - Restricted shell for devops SSH key
# Only allows: arch-agent-status, arch-agent-service, arch-agent-podman, arch-agent-dev

ALLOWED=(arch-agent-status arch-agent-service arch-agent-podman arch-agent-dev)
PREFIX="/usr/local/bin"

if [ -z "${SSH_ORIGINAL_COMMAND:-}" ]; then
    echo "Allowed commands:"
    for cmd in "${ALLOWED[@]}"; do echo "  $cmd"; done
    exit 1
fi

req=$(echo "$SSH_ORIGINAL_COMMAND" | awk '{print $1}')

for cmd in "${ALLOWED[@]}"; do
    if [ "$req" = "$cmd" ]; then
        exec $PREFIX/$SSH_ORIGINAL_COMMAND
    fi
done

echo "Command '$req' not allowed. Allowed: ${ALLOWED[*]}"
exit 1
