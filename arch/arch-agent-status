#!/bin/bash
# arch-agent-status - System status report (JSON)
set -euo pipefail

hostname=$(cat /etc/hostname 2>/dev/null || echo unknown)
uptime=$(uptime -s)
cpu_pct=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8}')
mem_total_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
mem_avail_kb=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
mem_total_gb=$(awk "BEGIN {printf \"%.1f\", $mem_total_kb/1024/1024}")
mem_avail_gb=$(awk "BEGIN {printf \"%.1f\", $mem_avail_kb/1024/1024}")
disk_info=$(df -h / /home 2>/dev/null | tail -n +2 | awk '{printf "{\"mount\":\"%s\",\"size\":\"%s\",\"used\":\"%s\",\"avail\":\"%s\",\"pct\":\"%s\"},", $6,$2,$3,$4,$5}' | sed 's/,$//')
load=$(uptime | awk -F'load average:' '{print $2}' | xargs)

cat <<EOF
{
  "hostname": "$hostname",
  "uptime_since": "$uptime",
  "cpu_pct": $cpu_pct,
  "memory": {
    "total_gb": $mem_total_gb,
    "avail_gb": $mem_avail_gb
  },
  "disks": [$disk_info],
  "load": "$load"
}
EOF
