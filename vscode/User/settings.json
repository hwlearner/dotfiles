{
  "vscode-neovim.neovimExecutablePaths.linux": "nvim",
  "vscode-neovim.neovimExecutablePaths.darwin": "nvim",
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
  "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim-vscode/init.lua",
  "vscode-neovim.neovimInitVimPaths.darwin": "~/.config/nvim-vscode/init.lua",
  "vscode-neovim.neovimInitVimPaths.win32": "~/.config/nvim-vscode/init.lua",
  "vscode-neovim.useWSL": false,

  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.startupEditor": "none",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.enablePreview": false,
  "workbench.editor.closeEmptyGroups": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 18,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.sideBar.location": "left",
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,

  "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', 'FiraCode Nerd Font', monospace",
  "editor.fontSize": 14,
  "editor.fontWeight": "normal",
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": true,
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 8,
  "editor.renderWhitespace": "selection",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.renderLineHighlight": "all",
  "editor.scrollBeyondLastLine": false,
  "editor.occurrencesHighlight": "singleFile",
  "editor.selectionHighlight": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.find.seedSearchStringFromSelection": "always",
  "editor.linkedEditing": true,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.suggestSelection": "first",
  "editor.suggest.insertMode": "replace",
  "editor.snippetSuggestions": "top",
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },

  "terminal.integrated.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'FiraCode Nerd Font', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.linux": "bash",

  "files.autoSave": "off",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/target/**": true,
    "**/build/**": true,
    "**/dist/**": true
  },
  "search.smartCase": true,
  "search.searchEditor.reusePriorSearchConfiguration": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/__pycache__": true
  },

  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "window.zoomLevel": 0,
  "window.restoreWindows": "none",

  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "mixed",
  "explorer.autoReveal": true,
  "explorer.openEditors.visible": 0,

  "git.confirmSync": false,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.suggestSmartCommit": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,

  "breadcrumbs.enabled": false,
  "telemetry.telemetryLevel": "off",
  "extensions.ignoreRecommendations": true,
  "extensions.autoUpdate": false,

  "debug.toolBarLocation": "docked",
  "debug.console.fontFamily": "'JetBrains Mono', monospace",
  "debug.console.lineHeight": 1.3,
  "debug.console.fontSize": 13,

  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    }
  },
  "[json]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[lua]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[c]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[cpp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },

  "lua.telemetry.enable": false,
  "redhat.telemetry.enabled": false,
  "gitlens.telemetry.enabled": false
}
